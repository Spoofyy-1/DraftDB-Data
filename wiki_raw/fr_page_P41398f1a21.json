"><span class=\"flagicon nowrap\"><span class=\"mw-image-border noviewer\" typeof=\"mw:File\"><a href=\"/wiki/Fichier:Flag_of_Lebanon.svg\" class=\"mw-file-description\" title=\"Drapeau du Liban\"><img alt=\"Drapeau du Liban\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/5/59/Flag_of_Lebanon.svg/20px-Flag_of_Lebanon.svg.png?utm_source=fr.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"13\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/5/59/Flag_of_Lebanon.svg/40px-Flag_of_Lebanon.svg.png?utm_source=fr.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"2880\" data-file-height=\"1920\" /></a></span> </span><a href=\"/wiki/Liban\" title=\"Liban\">Liban</a></span>\n</td>\n</tr>\n<tr>\n<th scope=\"row\">Naissance\n</th>\n<td colspan=\"2\"><time class=\"nowrap date-lien bday\" datetime=\"1993-02-03\" data-sort-value=\"1993-02-03\"><a href=\"/wiki/3_f%C3%A9vrier_en_sport\" title=\"3 f\u00e9vrier en sport\">3 f\u00e9vrier</a> <a href=\"/wiki/1993_en_basket-ball\" title=\"1993 en basket-ball\">1993</a></time><span class=\"noprint\"> (33&#160;ans)</span><br /><a href=\"/wiki/Saint_John%27s\" title=\"Saint John&#39;s\">Saint John's</a>, <a href=\"/wiki/Antigua-et-Barbuda\" title=\"Antigua-et-Barbuda\">Antigua-et-Barbuda</a>\n</td>\n</tr>\n<tr>\n\n<th scope=\"row\">Taille\n</th>\n<td colspan=\"2\">2,08&#160;<a href=\"/wiki/M%C3%A8tre\" title=\"M\u00e8tre\">m</a> (6<a href=\"/wiki/Pied_(unit%C3%A9)\" title=\"Pied (unit\u00e9)\">\u2032</a>&#160;10<a href=\"/wiki/Pouce_(unit%C3%A9)\" title=\"Pouce (unit\u00e9)\">\u2033</a>)\n</td>\n</tr>\n<tr>\n<th scope=\"row\">Poids\n</th>\n<td colspan=\"2\">105&#160;<a href=\"/wiki/Kilogramme\" title=\"Kilogramme\">kg</a> (231&#160;<a href=\"/wiki/Livre_(unit%C3%A9)\" title=\"Livre (unit\u00e9)\">lb</a>)\n</td>\n</tr>\n<tr>\n\n<th colspan=\"3\" style=\"padding:4px; text-align:center; backgroun