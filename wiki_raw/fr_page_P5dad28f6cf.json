org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"13\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/fa/Flag_of_the_People%27s_Republic_of_China.svg/40px-Flag_of_the_People%27s_Republic_of_China.svg.png?utm_source=fr.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"900\" data-file-height=\"600\" /></a></span></span><a href=\"/wiki/Shenzhen_Leopards\" title=\"Shenzhen Leopards\">Shenzhen Leopards</a>\n</td>\n</tr>\n<tr>\n<th scope=\"row\">Num\u00e9ro\n</th>\n<td colspan=\"2\">16\n</td>\n</tr>\n<tr>\n<th scope=\"row\">Poste\n</th>\n<td colspan=\"2\"><a href=\"/wiki/Pivot_(basket-ball)\" title=\"Pivot (basket-ball)\">Pivot</a>\n</td>\n</tr>\n<tr>\n<th colspan=\"3\" style=\"padding:4px; text-align:center; background-color:#DD8F56; color:#000000\">Carri\u00e8re universitaire ou amateur</th></tr>\n<tr>\n<th scope=\"row\">2018-2021\n</th>\n<td colspan=\"2\"><a href=\"/wiki/FC_Barcelone_(basket-ball)\" title=\"FC Barcelone (basket-ball)\">FC Barcelone</a>\n</td>\n</tr>\n<tr>\n<th colspan=\"3\" style=\"padding:4px; text-align:center; background-color:#DD8F56; color:#000000\">Draft de la NBA</th></tr>\n<tr>\n<th scope=\"row\">Ann\u00e9e\n</th>\n<td colspan=\"2\"><a href=\"/wiki/Draft_2022_de_la_NBA\" title=\"Draft 2022 de la NBA\">2022</a>\n</td>\n</tr>\n<tr>\n<th scope=\"row\">Position\n</th>\n<td colspan=\"2\">Non draft\u00e9\n</td>\n</tr>\n<tr>\n\n<th colspan=\"3\" style=\"padding:4px; text-align:center; background-color:#DD8F56; color:#000000\">Carri\u00e8re professionnelle *</th></tr>\n<tr>\n<td style=\"width:28%;\"><b>Saison</b></td><td><b>Club</b></td><td><b><abbr class=\"abbr\" title=\"Moyenne\">Moy.</abbr> <abbr class=\"abbr\" title=\"points\">pts</abbr></b></td></tr>\n<tr>\n<td valign=\"top\">2021-2022<br />2021-2022<br />2022<br /><a href=\"/wiki/Saison_NBA_2022-2023\" title=\"Saison NBA 2022-2023\">2022-2023</a><br />2023<br /><a href=\"/wiki/Saison_NBA_2023-2024\" title=\"Saison NBA 2023-2024\">2023-2024</a><br />2023-2024<br />2024-2025<br />2025</td><td valign=\"top\"><a href=\"/wiki/FC_Barcelone_(basket-ball)\" title=\"FC Barcelone (basket-ball)\">FC Barcelone</a><br /><span style=\"cursor:help;\" title=\"Pr\u00eat\u00e9 \u00e0\">\u2192</span> <a href=\"/w/index.php?title=For%C3%A7a_Lleida_CE&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"For\u00e7a Lleida CE (page inexistante)\">For\u00e7a Lleida</a>&#160;<a href=\"https://en.wikipedia.org/wiki/For%C3%A7a_Lleida_CE\" class=\"extiw\" title=\"en:For\u00e7a Lleida CE\"><span class=\"indicateur-langue\" title=\"Article en anglais&#160;: \u00ab&#160;For\u00e7a Lleida CE&#160;\u00bb\">(en)</span></a><br /><a href=\"/wiki/Herd_du_Wisconsin\" title=\"Herd du Wisconsin\">Herd du Wisconsin</a><br /><span class=\"nowrap\"><a href=\"/wiki/Trail_Blazers_de_Portland\" title=\"Trail Blazers de Portland\">Trail Blazers de Portland</a></span><br /><a href=\"/wiki/Herd_du_Wisconsin\" title=\"Herd du Wisconsin\">Herd du Wisconsin</a><br /><a href=\"/wiki/Trail_Blazers_de_Portland\" title=\"Trail Blazers de Portland\">Trail Blazers de Portland</a><br /><span style=\"cursor:help;\" title=\"Pr\u00eat\u00e9 \u00e0\">\u2192</span> <a href=\"/wiki/Remix_de_Rip_City\" title=\"Remix de Rip City\">Remix de Rip City</a><br /><a href=\"/wiki/Herd_du_Wisconsin\" title=\"Herd du Wisconsin\">Herd du Wisconsin</a><br /><a href=\"/wiki/Shenzhen_Leopards\" title=\"Shenzhen Leopards\">Shenzhen Leopards</a></td><td valign=\"top\"><s style=\"visibility:hidden;color:transparent\">0</s>0,7<br /><s style=\"visibility:hidden;color:transparent\">0</s>0,0<br /><s style=\"visibility:hidden;color:transparent\">0</s>8,4<br /><s style=\"visibility:hidden;color:transparent\">0</s>7,4<br /><abbr title=\"N&#39;a pas jou\u00e9\">DNP</abbr><br /><s style=\"visibility:hidden;color:transparent\">0</s>4,0<br /><s style=\"visibility:hidden;color:transparent\">0</s>1,5<br /><s style=\"visibility:hidden;color:transparent\">0</s>6,8</td></tr>\n<tr>\n<th colspan=\"3\" style=\"padding:4px; text-align:center; background-color:#DD8F56; color:#000000\">S\u00e9lection en \u00e9quipe nationale **</th></tr>\n<tr>\n<td valign=\"top\">2025-</td><td valign=\"top\"><span class=\"nowrap\"><span class=\"flagicon\"><span class=\"mw-image-border noviewer\" typeof=\"mw:File\"><a href=\"/wiki/Fichier:Flag_of_Senegal.svg\" class=\"mw-file-description\" title=\"Drapeau : S\u00e9n\u00e9gal\"><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/fd/Flag_of_Senegal.svg/20px-Flag_of_Senegal.svg.png?utm_source=fr.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"13\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/fd/Flag_of_Senegal.svg/40px-Flag_of_Senegal.svg.png?utm_source=fr.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"900\" data-file-height=\"600\" /></a></span></span> <a href=\"/wiki/%C3%89quipe_du_S%C3%A9n%C3%A9gal_masculine_de_basket-ball\" title=\"\u00c9quipe du S\u00e9n\u00e9gal masculine de basket-ball\">S\u00e9n\u00e9gal</a></span></td></tr>\n<tr>\n\n\n\n\n\n\n<td colspan=\"3\"><hr style=\"height:2px; color:inherit; background-color:#DD8F56;\" /></td></tr>\n<tr>\n<td colspan=\"3\" style=\"text-align:center;color:#555555;\"><small>* Points marqu\u00e9s dans chaque club dans le cadre de la saison r\u00e9guli\u00e8re du championnat national.</small></td>\n</tr><tr>\n<td colspan=\"3\" style=\"text-align:center;color:#555555;\"><small>** Points marqu\u00e9s pour l\u2019\u00e9quipe nationale en match officiel.</small></td>\n</tr><tr>\n<td class=\"navigation-only\" colspan=\"3\" style=\"border-top: 2px #DD8F56 solid; font-size: 80%; background:inherit; color: inherit; text-align: right;\"><span class=\"plainlinks\" style=\"float:left;\"><a class=\"external text\" data-mw-original-href=\"//fr.wikipedia.org/w/index.php?title=Ibou_Badji&amp;action=edit&amp;section=0\" href=\"https://fr.wikipedia.org/w/index.php?title=Ibou_Badji&amp;action=edit&amp;section=0\"><span class=\"infodoc\">modifier</span></a></span>&#160;<span typeof=\"mw:File\"><a href=\"/wiki/Mod%C3%A8le:Infobox_Joueur_de_basket-ball\" title=\"Consultez la documentation du mod\u00e8le\"><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/3/38/Info_Simple.svg/20px-Info_Simple.svg.png?utm_source=fr.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"12\" height=\"12\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/3/38/Info_Simple.svg/40px-Info_Simple.svg.png?utm_source=fr.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"512\" data-file-height=\"512\" /></a></span></td>\n</tr>\n</tbody></table>\n<p><b>Ibou Dianko Badji</b>, n\u00e9 le <time class=\"nowrap date-lien bday\" datetime=\"2002-10-13\" data-sort-value=\"2002-10-13\"><a href=\"/wiki/13_octobre_en_sport\" title=\"13 octobre en sport\">13 octobre</a> <a href=\"/wiki/2002_en_basket-ball\" title=\"2002 en basket-ball\">2002</a></time> \u00e0 <a href=\"/wiki/Dakar\" title=\"Dakar\">Dakar</a> au <a href=\"/wiki/S%C3%A9n%C3%A9gal\" title=\"S\u00e9n\u00e9gal\">S\u00e9n\u00e9gal</a>, est un joueur <a href=\"/wiki/S%C3%A9n%C3%A9gal\" title=\"S\u00e9n\u00e9gal\">s\u00e9n\u00e9galais</a> de <a href=\"/wiki/Basket-ball\" title=\"Basket-ball\">basket-ball</a> mesurant 2,13 m et \u00e9voluant au poste de <a href=\"/wiki/Pivot_(basket-ball)\" title=\"Pivot (basket-ball)\">pivot</a>.\n</p>\n<meta property=\"mw:PageProp/toc\" />\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Biographie\">Biographie</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Ibou_Badji&amp;veaction=edit&amp;section=1\" title=\"Modifier la section\u202f: Biographie\" class=\"mw-editsection-visualeditor\"><span>modifier</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Ibou_Badji&amp;action=edit&amp;section=1\" title=\"Modifier le code source de la section : Biographie\"><span>modifier le code</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Parcours_en_Europe\">Parcours en Europe</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Ibou_Badji&amp;veaction=edit&amp;section=2\" title=\"Modifier la section\u202f: Parcours en Europe\" class=\"mw-editsection-visualeditor\"><span>modifier</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Ibou_Badji&amp;action=edit&amp;section=2\" title=\"Modifier le code source de la section : Parcours en Europe\"><span>modifier le code</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p>Entre 2018 et 2021, il joue au <a href=\"/wiki/FC_Barcelone_(basket-ball)\" title=\"FC Barcelone (basket-ball)\">FC Barcelone</a>, d'abord en junior et pour l'\u00e9quipe B, puis avec le groupe professionnel, ce qui lui permet de jouer quelques minutes en <a href=\"/wiki/Championnat_d%27Espagne_de_basket-ball\" class=\"mw-redirect\" title=\"Championnat d&#39;Espagne de basket-ball\">Liga ACB</a>.\n</p><p>Pour la saison 2021-2022, il est pr\u00eat\u00e9 en <a href=\"/wiki/Liga_espa%C3%B1ola_de_baloncesto\" class=\"mw-redirect\" title=\"Liga espa\u00f1ola de baloncesto\">deuxi\u00e8me division professionnelle espagnole</a> au <a href=\"/w/index.php?title=For%C3%A7a_Lleida_CE&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"For\u00e7a Lleida CE (page inexistante)\">For\u00e7a Lleida</a>&#160;<a href=\"https://en.wikipedia.org/wiki/For%C3%A7a_Lleida_CE\" class=\"extiw\" title=\"en:For\u00e7a Lleida CE\"><span class=\"indicateur-langue\" title=\"Article en anglais&#160;: \u00ab&#160;For\u00e7a Lleida CE&#160;\u00bb\">(en)</span></a><sup id=\"cite&#95;ref-1\" class=\"reference\"><a href=\"#cite_note-1\"><span class=\"cite-bracket\">&#91;</span>1<span class=\"cite-bracket\">&#93;</span></a></sup>.\n</p>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Carri\u00e8re_aux_\u00c9tats-Unis\"><span id=\"Carri.C3.A8re_aux_.C3.89tats-Unis\"></span>Carri\u00e8re aux \u00c9tats-Unis</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Ibou_Badji&amp;veaction=edit&amp;section=3\" title=\"Modifier la section\u202f: Carri\u00e8re aux \u00c9tats-Unis\" class=\"mw-editsection-visualeditor\"><span>modifier</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Ibou_Badji&amp;action=edit&amp;section=3\" title=\"Modifier le code source de la section : Carri\u00e8re aux \u00c9tats-Unis\"><span>modifier le code</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p>Lors de la <a href=\"/wiki/Draft_2022_de_la_NBA\" title=\"Draft 2022 de la NBA\">draft 2022 de la NBA</a>, il n'est pas s\u00e9lectionn\u00e9. Malgr\u00e9 tout, il commence la saison en <a href=\"/wiki/NBA_Gatorade_League\" class=\"mw-redirect\" title=\"NBA Gatorade League\">NBA G League</a> au <a href=\"/wiki/Herd_du_Wisconsin\" title=\"Herd du Wisconsin\">Herd du Wisconsin</a><sup id=\"cite&#95;ref-2\" class=\"reference\"><a href=\"#cite_note-2\"><span class=\"cite-bracket\">&#91;</span>2<span class=\"cite-bracket\">&#93;</span></a></sup>.\n</p><p>En <time class=\"nowrap\" datetime=\"2022-11\" data-sort-value=\"2022-11\">novembre 2022</time>, il signe un contrat <i>two-way</i> en faveur des <a href=\"/wiki/Trail_Blazers_de_Portland\" title=\"Trail Blazers de Portland\">Trail Blazers de Portland</a> en <a href=\"/wiki/NBA\" class=\"mw-redirect\" title=\"NBA\">NBA</a><sup id=\"cite&#95;ref-3\" class=\"reference\"><a href=\"#cite_note-3\"><span class=\"cite-bracket\">&#91;</span>3<span class=\"cite-bracket\">&#93;</span></a></sup>. Son contrat <i>two-way</i> est renouvel\u00e9 en <time class=\"nowrap\" datetime=\"2023-07\" data-sort-value=\"2023-07\">juillet 2023</time>. Il est coup\u00e9 en <time class=\"nowrap\" datetime=\"2023-10\" data-sort-value=\"2023-10\">octobre 2023</time> puis resign\u00e9 en <time class=\"nowrap\" datetime=\"2023-11\" data-sort-value=\"2023-11\">novembre 2023</time>. En 2024, Ibou Badji retourne au <a href=\"/wiki/Herd_du_Wisconsin\" title=\"Herd du Wisconsin\">Herd du Wisconsin</a> avant de rejoindre en <time class=\"nowrap\" datetime=\"2025-09\" data-sort-value=\"2025-09\">septembre 2025</time> le <a href=\"/wiki/Swarm_de_Greensboro\" title=\"Swarm de Greensboro\">Swarm de Greensboro</a><sup id=\"cite&#95;ref-4\" class=\"reference\"><a href=\"#cite_note-4\"><span class=\"cite-bracket\">&#91;</span>4<span class=\"cite-bracket\">&#93;</span></a></sup>.\n</p>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"En_s\u00e9lection\"><span id=\"En_s.C3.A9lection\"></span>En s\u00e9lection</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Ibou_Badji&amp;veaction=edit&amp;section=4\" title=\"Modifier la section\u202f: En s\u00e9lection\" class=\"mw-editsection-visualeditor\"><span>modifier</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Ibou_Badji&amp;action=edit&amp;section=4\" title=\"Modifier le code source de la section : En s\u00e9lection\"><span>modifier le code</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p>Il a repr\u00e9sent\u00e9 le <a href=\"/wiki/%C3%89quipe_du_S%C3%A9n%C3%A9gal_de_basket-ball\" class=\"mw-redirect\" title=\"\u00c9quipe du S\u00e9n\u00e9gal de basket-ball\">S\u00e9n\u00e9gal</a> lors des <a href=\"/wiki/Coupe_du_monde_masculine_de_basket-ball_des_moins_de_19_ans\" title=\"Coupe du monde masculine de basket-ball des moins de 19 ans\">coupes du monde des moins de 19 ans</a> de <a href=\"/wiki/Coupe_du_monde_masculine_de_basket-ball_des_moins_de_19_ans_2019\" title=\"Coupe du monde masculine de basket-ball des moins de 19 ans 2019\">2019</a> et <a href=\"/wiki/Coupe_du_monde_masculine_de_basket-ball_des_moins_de_19_ans_2021\" title=\"Coupe du monde masculine de basket-ball des moins de 19 ans 2021\">2021</a>. En 2025, avec les forfaits de <a href=\"/wiki/Tacko_Fall\" title=\"Tacko Fall\">Tacko Fall</a> et <a href=\"/wiki/Youssou_Ndoye\" title=\"Youssou Ndoye\">Youssou Ndoye</a>, Ibou Badji est appel\u00e9 avec l'\u00e9quipe senior du S\u00e9n\u00e9gal pour disputer l'<a href=\"/wiki/Championnat_d%27Afrique_masculin_de_basket-ball_2025\" title=\"Championnat d&#39;Afrique masculin de basket-ball 2025\">Afrobasket 2025</a> qui se d\u00e9roule en <a href=\"/wiki/Angola\" title=\"Angola\">Angola</a><sup id=\"cite&#95;ref-5\" class=\"reference\"><a href=\"#cite_note-5\"><span class=\"cite-bracket\">&#91;</span>5<span class=\"cite-bracket\">&#93;</span></a></sup>.\n</p>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Palmar\u00e8s\"><span id=\"Palmar.C3.A8s\"></span>Palmar\u00e8s</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Ibou_Badji&amp;veaction=edit&amp;section=5\" title=\"Modifier la section\u202f: Palmar\u00e8s\" class=\"mw-editsection-visualeditor\"><span>modifier</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Ibou_Badji&amp;action=edit&amp;section=5\" title=\"Modifier le code source de la section : Palmar\u00e8s\"><span>modifier le code</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<ul><li><a href=\"/wiki/2020_en_basket-ball\" title=\"2020 en basket-ball\">2020</a>&#160;: <span data-sort-value=\"02\"><span typeof=\"mw:File\"><span title=\"M\u00e9daille d&#39;argent, Afrique\"><img alt=\"M\u00e9daille d&#39;argent, Afrique\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/fa/Silver_medal_africa.svg/20px-Silver_medal_africa.svg.png?utm_source=fr.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"16\" height=\"16\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/fa/Silver_medal_africa.svg/40px-Silver_medal_africa.svg.png?utm_source=fr.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"300\" data-file-height=\"300\" /></span></span></span> m\u00e9daille d'argent au <a href=\"/wiki/Championnat_d%27Afrique_masculin_de_basket-ball_des_moins_de_18_ans\" title=\"Championnat d&#39;Afrique masculin de basket-ball des moins de 18 ans\">Championnat d\u2019Afrique FIBA des moins de 18 ans</a></li>\n<li><span data-sort-value=\"03\"><span typeof=\"mw:File\"><span title=\"M\u00e9daille de bronze, Afrique\"><img alt=\"M\u00e9daille de bronze, Afrique\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/41/Bronze_medal_africa.svg/20px-Bronze_medal_africa.svg.png?utm_source=fr.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"16\" height=\"16\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/41/Bronze_medal_africa.svg/40px-Bronze_medal_africa.svg.png?utm_source=fr.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"300\" data-file-height=\"300\" /></span></span></span> M\u00e9daill\u00e9 de bronze du <a href=\"/wiki/Championnat_d%27Afrique_masculin_de_basket-ball_2025\" title=\"Championnat d&#39;Afrique masculin de basket-ball 2025\">Championnat d'Afrique masculin de basket-ball 2025</a></li></ul>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"R\u00e9f\u00e9rences\"><span id=\"R.C3.A9f.C3.A9rences\"></span>R\u00e9f\u00e9rences</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Ibou_Badji&amp;veaction=edit&amp;section=6\" title=\"Modifier la section\u202f: R\u00e9f\u00e9rences\" class=\"mw-editsection-visualeditor\"><span>modifier</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Ibou_Badji&amp;action=edit&amp;section=6\" title=\"Modifier le code source de la section : R\u00e9f\u00e9rences\"><span>modifier le code</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<div class=\"references-small decimal\" style=\"\"><div class=\"mw-references-wrap\"><ol class=\"references\">\n<li id=\"cite&#95;note-1\"><span class=\"mw-cite-backlink\"><a href=\"#cite_ref-1\">\u2191</a> </span><span class=\"reference-text\"><span class=\"ouvrage\" id=\"Pujol2021\"><span class=\"ouvrage\" id=\"Xavi&#95;Pujol2021\"><abbr class=\"abbr indicateur-langue\" title=\"Langue : espagnol\">(es)</abbr> Xavi Pujol, \u00ab&#160;<a rel=\"nofollow\" class=\"external text\" href=\"https://www.segre.com/es/noticias/deportes/2021/10/07/badji_era_una_incorporacion_deseada_desde_verano_148631_1110.html\"><cite style=\"font-style:normal;\" lang=\"es\">\u201cBadji era una incorporaci\u00f3n deseada desde el verano\u201d</cite></a>&#160;\u00bb, sur <span class=\"italique\">segre.com</span>, <time class=\"nowrap\" datetime=\"2021-10-07\" data-sort-value=\"2021-10-07\">7 octobre 2021</time> <small style=\"line-height:1em;\">(consult\u00e9 le <time class=\"nowrap\" datetime=\"2023-11-21\" data-sort-value=\"2023-11-21\">21 novembre 2023</time>)</small></span></span>.</span>\n</li>\n<li id=\"cite&#95;note-2\"><span class=\"mw-cite-backlink\"><a href=\"#cite_ref-2\">\u2191</a> </span><span class=\"reference-text\"><a rel=\"nofollow\" class=\"external free\" href=\"https://wosqfm.com/2022/09/20/bucks-sign-badji-to-exhibit-10-deal/\">https://wosqfm.com/2022/09/20/bucks-sign-badji-to-exhibit-10-deal/</a></span>\n</li>\n<li id=\"cite&#95;note-3\"><span class=\"mw-cite-backlink\"><a href=\"#cite_ref-3\">\u2191</a> </span><span class=\"reference-text\"><span class=\"ouvrage\"><abbr class=\"abbr indicateur-langue\" title=\"Langue : anglais\">(en)</abbr> \u00ab&#160;<a rel=\"nofollow\" class=\"external text\" href=\"https://twitter.com/wojespn/status/1593671591136722947\"><cite style=\"font-style:normal;\" lang=\"en\">Adrian Wojnarowski (@wojespn) on X</cite></a>&#160;\u00bb, sur <span class=\"italique\"><a href=\"/wiki/Twitter\" class=\"mw-redirect\" title=\"Twitter\">Twitter</a></span> <small style=\"line-height:1em;\">(consult\u00e9 le <time class=\"nowrap\" datetime=\"2023-11-21\" data-sort-value=\"2023-11-21\">21 novembre 2023</time>)</small></span>.</span>\n</li>\n<li id=\"cite&#95;note-4\"><span class=\"mw-cite-backlink\"><a href=\"#cite_ref-4\">\u2191</a> </span><span class=\"reference-text\"><span class=\"ouvrage\">\u00ab&#160;<a rel=\"nofollow\" class=\"external text\" href=\"https://wiwsport.com/2025/09/01/g-league-2025-ibou-badji-rejoint-la-filiale-des-hornets-greensboro-swarm/\"><cite style=\"font-style:normal;\">G League 2025&#160;: Ibou Badji rejoint la filiale des Hornets, Greensboro Swarm&#160;! | Wiwsport</cite></a>&#160;\u00bb, <time class=\"nowrap\" datetime=\"2025-09-01\" data-sort-value=\"2025-09-01\"><abbr class=\"abbr\" title=\"premier\">1<sup>er</sup></abbr> septembre 2025</time> <small style=\"line-height:1em;\">(consult\u00e9 le <time class=\"nowrap\" datetime=\"2025-09-02\" data-sort-value=\"2025-09-02\">2 septembre 2025</time>)</small></span></span>\n</li>\n<li id=\"cite&#95;note-5\"><span class=\"mw-cite-backlink\"><a href=\"#cite_ref-5\">\u2191</a> </span><span class=\"reference-text\"><span class=\"ouvrage\">\u00ab&#160;<a rel=\"nofollow\" class=\"external text\" href=\"https://wiwsport.com/2025/08/19/afrobasket-2025-ibou-dianko-badji-le-mur-defensif-des-lions/\"><cite style=\"font-style:normal;\">Afrobasket 2025 \u2013 Ibou Dianko Badji, le mur d\u00e9fensif des Lions&#160;! | Wiwsport</cite></a>&#160;\u00bb, <time class=\"nowrap\" datetime=\"2025-08-19\" data-sort-value=\"2025-08-19\">19 ao\u00fbt 2025</time> <small style=\"line-height:1em;\">(consult\u00e9 le <time class=\"nowrap\" datetime=\"2025-08-22\" data-sort-value=\"2025-08-22\">22 ao\u00fbt 2025</time>)</small></span></span>\n</li>\n</ol></div>\n</div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Liens_externes\">Liens externes</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=Ibou_Badji&amp;veaction=edit&amp;section=7\" title=\"Modifier la section\u202f: Liens externes\" class=\"mw-editsection-visualeditor\"><span>modifier</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=Ibou_Badji&amp;action=edit&amp;section=7\" title=\"Modifier le code source de la section : Liens externes\"><span>modifier le code</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<style data-mw-deduplicate=\"TemplateStyles:r194021218\">.mw-parser-output .autres-projets>.titre{text-align:center;margin:0.2em 0}.mw-parser-output .autres-projets>ul{margin:0;padding:0}.mw-parser-output .autres-projets>ul>li{list-style:none;margin:0.2em 0;text-indent:0;padding-left:24px;min-height:20px;text-align:left;display:block}.mw-parser-output .autres-projets>ul>li>a{font-style:italic}@media(max-width:720px){.mw-parser-output .autres-projets{float:none}}</style><div class=\"autres-projets boite-grise boite-a-droite noprint js-interprojets\">\n<p class=\"titre\">Sur les autres projets Wikimedia&#160;:</p>\n<ul class=\"noarchive plainlinks\">\n<li class=\"commons\"><a class=\"external text\" href=\"https://commons.wikimedia.org/wiki/Category:Ibou_Badji?uselang=fr\">Ibou Badji</a>, sur <span class=\"project\">Wikimedia Commons</span></li>\n</ul>\n</div>\n<ul><li><span class=\"liste-horizontale noarchive\"><span class=\"wd&#95;identifiers\">Ressources relatives au sport<span class=\"noprint wikidata-linkback skin-invert\"><span class=\"mw-valign-baseline noviewer\" typeof=\"mw:File\"><a href=\"https://www.wikidata.org/wiki/Q88967183?uselang=fr#identifiers\" title=\"Voir et modifier les donn\u00e9es sur Wikidata\"><img alt=\"Voir et mo