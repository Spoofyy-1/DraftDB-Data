{"parse": {"title": "Naz Mitrou-Long", "pageid": 11618427, "redirects": [], "text": {"*": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"fr\" dir=\"ltr\"><div class=\"bandeau-container metadata bandeau-article bandeau-niveau-ebauche\"><div class=\"bandeau-cell bandeau-icone\" style=\"display:table-cell;padding-right:0.5em\"><span style=\"white-space:nowrap;word-spacing:5px\"><span class=\"noviewer\" typeof=\"mw:File\"><a href=\"/wiki/Fichier:Basketball_ball.svg\" class=\"mw-file-description\"><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/5/5a/Basketball_ball.svg/40px-Basketball_ball.svg.png?utm_source=fr.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"33\" height=\"35\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/5/5a/Basketball_ball.svg/120px-Basketball_ball.svg.png?utm_source=fr.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"389\" data-file-height=\"407\" /></a></span> <span class=\"noviewer\" typeof=\"mw:File\"><a href=\"/wiki/Fichier:Nuvola_Canada_flag.svg\" class=\"mw-file-description\"><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/a/ac/Nuvola_Canada_flag.svg/40px-Nuvola_Canada_flag.svg.png?utm_source=fr.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"35\" height=\"35\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/a/ac/Nuvola_Canada_flag.svg/120px-Nuvola_Canada_flag.svg.png?utm_source=fr.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"64\" data-file-height=\"64\" /></a></span> <span class=\"noviewer\" typeof=\"mw:File\"><a href=\"/wiki/Fichier:Nuvola_Greek_flag.svg\" class=\"mw-file-description\"><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/9e/Nuvola_Greek_flag.svg/40px-Nuvola_Greek_flag.svg.png?utm_source=fr.wikipedia.o