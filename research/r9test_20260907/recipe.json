  "seed_aggregation": {
    "per_seed_outputs": true,
    "fixed_average": "score=sum of all three per-seed doubled integer average-tied ranks/(6*nquery), ranks computed after each seed exact-vector canonicalization on full query pool; no fitted weights or selected seed",
    "interpretation": "Parent scores each seed separately and the fixed rank average separately. H57.9% is mean seed/fold Spearman, not the metric of this rank average."
  },
  "scoring": "Root owns sealed evaluation answers and all scoring. Horizons fixed2019/2020/2021=5,2022=4,2023=3,2024=2,2025=1, benchmark ending2026. Root reports each seed and fixed rank average on both full-query legacy-zero truth and complete-horizon masks. All seven cohorts predictions must be immutable before any scoring; no score feedback into recipe.",
  "execution": {
    "reference_tasks": 3,
    "evaluation_fit_tasks": 21,
    "GPU_launch_authorized": false,
    "after_current_I_only": false,
    "preserve_I_unchanged": true,
    "raw_predictions_remote": true,
    "concurrent_with_I_only_if_GPU_free_GiB_at_least": 20,
    "one_test_year_process_at_a_time": true,
    "per_year_workers": 1,
    "per_year_CPU_threads": 2,
    "per_year_memory_GiB": 24,
    "per_year_runtime_seconds": 1800,
    "fresh_namespace_cache_and_process_each_year": true,
